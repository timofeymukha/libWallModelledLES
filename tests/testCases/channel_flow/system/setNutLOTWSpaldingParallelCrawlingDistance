FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Sample from the cell with the centre at y = 1.3 by crawling.
// The decomposition places a processor boundary at the centre of the channel,
// so the sampling cells of bottomWall are on another processor.

nut
{
    boundaryField
    {
        bottomWall
        {
            type            LOTWWallModel;
            value           uniform 0;
            sampler         CrawlingParallel;
            hIsIndex        0;
            RootFinder
            {
                type    Newton;
            }
            Law
            {
                type    Spalding;
            }
        }
    }
}

hSampler
{
    boundaryField
    {
        bottomWall
        {
            type            fixedValue;
            value           uniform 1.3;
        }
    }
}

