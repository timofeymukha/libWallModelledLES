FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Parabolic velocity profile, such that the sampled velocity depends on the
// sampling cell.

expressions
(
    U
    {
        field       U;
        dimensions  [0 1 -1 0 0 0 0];
        expression  #{ vector(pos().y()*(2 - pos().y()), 0, 0) #};
    }
);

